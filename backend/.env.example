NODE_ENV=production
PORT=5000

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get your connection string from https://cloud.mongodb.com
# Replace <username>, <password>, and <cluster> with your actual values
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/rehab-ai?retryWrites=true&w=majority&appName=RehabAI

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRE=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# For GitHub Pages: https://saiimmani.github.io
# For local dev: http://localhost:3000
ALLOWED_ORIGINS=https://saiimmani.github.io,http://localhost:3000
