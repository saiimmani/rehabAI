NODE_ENV=development
PORT=5000

# ── MongoDB ─────────────────────────────────────────────────────────────────
# Local MongoDB  (MUST include the database name at the end)
MONGODB_URI=mongodb://localhost:27017/rehab-ai

# MongoDB Atlas  (replace with your own connection string)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/rehab-ai?retryWrites=true&w=majority

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRE=7d
