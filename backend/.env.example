NODE_ENV=development
PORT=5000

# Local MongoDB (default)
MONGODB_URI=mongodb://127.0.0.1:27017/rehab-ai

# MongoDB Atlas (cloud) — uncomment and replace with your connection string
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/rehab-ai?retryWrites=true&w=majority

JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d
