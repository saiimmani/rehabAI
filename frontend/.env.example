# Frontend environment variables
# Copy this file to .env.local for local development

# For LOCAL development (backend running on your machine)
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_SOCKET_URL=http://localhost:5000

# For PRODUCTION (GitHub Pages), override these with your Render backend URL:
# REACT_APP_API_URL=https://rehabai-backend.onrender.com/api
# REACT_APP_SOCKET_URL=https://rehabai-backend.onrender.com
